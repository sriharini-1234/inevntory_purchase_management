# SQL Server (recommended for this assignment)
# Update SERVER, DATABASE and authentication details for your machine.
DATABASE_URL=mssql+pyodbc://@localhost/InventoryDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# For a quick local demo without SQL Server, use:
# DATABASE_URL=sqlite:///./inventory.db

FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
